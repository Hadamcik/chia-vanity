{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chia Vanity",
  "version": "0.1.0",
  "identifier": "com.hadamcik.chia-vanity-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chia Vanity",
        "width": 1100,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
