{
  "name": "chia-vanity-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:wasm-local": "node scripts/prepare-local-wasm.mjs",
    "dev": "pnpm prepare:wasm-local && vite",
    "sage:finalize": "sage-app finalize-manifest --source sage-manifest.json --dist ./dist",
    "build:cloudflare": "tsc && vite build && pnpm sage:finalize",
    "build": "pnpm prepare:wasm-local && tsc && vite build && pnpm sage:finalize",
    "tauri:dev": "pnpm build && tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "chia-wallet-sdk-wasm": "file:vendor-pkg/chia-wallet-sdk-wasm",
    "webgpu-vanity-wasm": "file:vendor-pkg/webgpu-vanity-wasm",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sage-app-sdk": "^0.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.2"
  }
}
